# Copy to .env and fill in. Never commit .env.

POSTGRES_PASSWORD=relay-dev-password
APP_DB_PASSWORD=relay-app-password

# Kestra UI / API login (must be an email; password needs 8+ chars, an uppercase letter and a number)
KESTRA_USER=admin@relay.dev
KESTRA_PASSWORD=RelayAdmin2026

# Gemini — leave empty to run with the built-in offline fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_SMART=gemini-2.5-pro
GEMINI_EMBED_MODEL=gemini-embedding-001
# Use Vertex AI instead of an API key (on Google Cloud): set both and leave GEMINI_API_KEY empty.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# Signs login tokens. Change it.
RELAY_SECRET=change-me-to-a-long-random-string
# Shared secret for hooks (Claude, git) and Kestra webhooks.
RELAY_INGEST_TOKEN=change-me-ingest-token

# Optional: open real pull requests for on-call fixes. Without these, fixes are applied locally on approval.
GITHUB_TOKEN=
GITHUB_REPO=
