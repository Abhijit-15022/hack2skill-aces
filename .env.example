# Copy to .env and fill in. Never commit .env.

POSTGRES_PASSWORD=relay-dev-password
APP_DB_PASSWORD=relay-app-password

# Gemini — leave GEMINI_API_KEY empty to run with the built-in offline fallbacks.
# smart: diagnosis, planning, meetings, SOP drafting · fast: summaries, Ask · lite: quick yes/no checks
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_THINKING_SMART=high
GEMINI_THINKING_MEETING=medium
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_THINKING_FAST=low
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_API_KEY=
# Use Vertex AI instead of an API key (on Google Cloud): set both and leave GEMINI_API_KEY empty.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# Signs login tokens. Change it.
RELAY_SECRET=change-me-to-a-long-random-string
# Shared secret for hooks (Claude, git) and orchestrator webhooks.
RELAY_INGEST_TOKEN=change-me-ingest-token

# Optional: open real pull requests for on-call fixes. Without these, fixes are applied locally on approval.
GITHUB_TOKEN=
GITHUB_REPO=
